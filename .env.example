# Production admin auth
# Generate a bcrypt hash locally with: ADMIN_PASSWORD='<strong-password>' pnpm hash:admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Optional one-time production setup switch. Keep empty/false after setup.
ALLOW_ADMIN_SETUP=false

# Optional Vercel Blob object names. Defaults are safe for production.
# SITE_CONTENT_BLOB_PATH=content/site-content.json
# RESERVATION_REQUESTS_BLOB_PATH=content/reservation-requests.json
# ADMIN_AUTH_BLOB_PATH=content/.admin-auth.json

# Optional payment infrastructure.
# Keep disabled until merchant credentials are ready.
PAYMENT_PROVIDER=disabled
# Website reservations are confirmed immediately when payment is disabled.
# Use "manual" if the hotel wants every website record to stay as a request first.
# WEBSITE_RESERVATION_MODE=instant
# WEBSITE_RESERVATION_MODE=manual
# PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=paytr
# PAYMENT_BASE_URL=https://sukruefendiotel.com
# PAYMENT_AMOUNT_MODE=full
# PAYMENT_AMOUNT_MODE=deposit_percent
# PAYMENT_DEPOSIT_PERCENT=30
# PAYMENT_HOLD_MINUTES=30
# PAYMENT_MOCK_SECRET=
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=1
# PAYTR_DEBUG_ON=0
# PAYTR_NO_INSTALLMENT=0
# PAYTR_MAX_INSTALLMENT=0
# PAYTR_TIMEOUT_LIMIT=30

# Optional persistent content location for VPS deployments.
# SITE_CONTENT_DIR=/var/www/sukru-efendi-content
# Optional reservation file location. If empty, SITE_CONTENT_DIR/reservation-requests.json is used.
# RESERVATION_REQUESTS_FILE=/var/www/sukru-efendi-content/reservation-requests.json
# Optional public directory for uploads. In standalone deployments this should
# point to the public directory served by the running app.
# SITE_PUBLIC_DIR=/var/www/sukru-efendi-app/.next/standalone/public
