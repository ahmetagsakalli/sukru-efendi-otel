# Production admin auth
# Generate a bcrypt hash locally with: ADMIN_PASSWORD='<strong-password>' pnpm hash:admin-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional one-time production setup switch. Keep empty/false after setup.
ALLOW_ADMIN_SETUP=false

# Optional persistent content location for VPS deployments.
# SITE_CONTENT_DIR=/var/www/sukru-efendi-content
# Optional reservation file location. If empty, SITE_CONTENT_DIR/reservation-requests.json is used.
# RESERVATION_REQUESTS_FILE=/var/www/sukru-efendi-content/reservation-requests.json
# Optional public directory for uploads. In standalone deployments this should
# point to the public directory served by the running app.
# SITE_PUBLIC_DIR=/var/www/sukru-efendi-app/.next/standalone/public
